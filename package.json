{
  "name": "crm.sdk",
  "version": "1.0.0",
  "description": "Typed CRM SDK for AI agents",
  "author": "Sheikh Sifat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunkernine/crm.sdk.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun test --timeout 30000 --max-concurrency 1",
    "lint": "ultracite fix",
    "prepublishOnly": "bun run build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite fix"
    ]
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "libphonenumber-js": "^1.12.0",
    "normalize-url": "^9.0.0",
    "postgres": "^3.4.9",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.2.10",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "~5.9.3",
    "ultracite": "^7.2.3"
  }
}
